# =============================================================
# Production Environment Variables
# =============================================================
# Copy this file and fill in the values before deploying.
# Do NOT commit this file with real secrets.
# =============================================================

# ---- PostgreSQL (Neon) ----
# Get from: https://console.neon.tech → Connection Details
DATABASE_URL="postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/graphrag?sslmode=require"

# ---- Neo4j (Aura Free) ----
# Get from: https://console.neo4j.cloud → Connect → Driver connection string
NEO4J_URI="neo4j+s://xxxx.databases.neo4j.io"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="your-aura-password"
NEO4J_DATABASE="neo4j"

# ---- Chroma (Chroma Cloud) ----
# Base URL ONLY (no tenant/database path). Tenant/database are separate vars below.
CHROMA_URL="https://api.trychroma.com"
CHROMA_COLLECTION="graphrag_chunks"
# Chroma Cloud API key (required)
CHROMA_API_KEY=""
# Your tenant and database names from the Chroma Cloud console (default: default_tenant / default_database)
CHROMA_TENANT=""
CHROMA_DATABASE=""

# ---- AI Provider ----
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-xxx"
# Optional: HuggingFace fallback
# HUGGINGFACE_API_KEY="hf_xxx"

# ---- Auth ----
# Generate with: openssl rand -hex 32
JWT_SECRET="your-generated-secret-here"

# ---- Google OAuth (optional Sign in with Google) ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# The redirect URI must match the deployed API origin exactly.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_AUTH_REDIRECT_URI="https://graphrag-api.onrender.com/api/auth/google/callback"

# ---- CORS / URLs ----
# Your Vercel frontend URL
WEB_URL="https://your-app.vercel.app"
# Your Render API URL
API_URL="https://graphrag-api.onrender.com"

# ---- Demo ----
ENABLE_DEMO_SETUP="true"

# ---- Retrieval Tuning ----
MAX_VECTOR_RESULTS=20
MAX_GRAPH_DEPTH=3
MAX_GRAPH_NODES=50
TOP_K_RERANKED=10
