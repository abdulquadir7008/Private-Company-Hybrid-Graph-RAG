# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://graphrag_user:graphrag_password@localhost:5433/graphrag?schema=public"

# --- API ---
API_PORT=4000
WEB_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
UPLOAD_DIR="./uploads"

# --- Neo4j ---
NEO4J_URI="neo4j://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="graphrag-password"
NEO4J_DATABASE="neo4j"

# --- Chroma ---
CHROMA_URL="http://localhost:8000"
CHROMA_COLLECTION="graphrag_chunks"
# Optional: API key for managed Chroma (e.g. Chroma Cloud)
CHROMA_API_KEY=""
# Optional: tenant/database for managed Chroma. Leave empty for local (single-tenant demo).
CHROMA_TENANT=""
CHROMA_DATABASE=""

# --- AI Providers ---
AI_PROVIDER="openai"                 # "openai" | "huggingface"
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
HUGGINGFACE_API_KEY=""
HUGGINGFACE_CHAT_MODEL="meta-llama/Llama-3.3-70B-Instruct"
HUGGINGFACE_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# --- Auth ---
# Required. Generate with: openssl rand -hex 32
JWT_SECRET=""
JWT_EXPIRES_IN="1d"

# --- Email (SendGrid) ---
SENDGRID_API_KEY=""
SENDGRID_FROM="GraphRAG Assistant <no-reply@example.com>"

# --- Root admin (optional platform operator) ---
ROOT_ADMIN_EMAIL=""
ROOT_ADMIN_PASSWORD=""

# --- Demo / seed ---
ENABLE_DEMO_SETUP="true"

# --- Retrieval tuning (optional overrides) ---
MAX_VECTOR_RESULTS=20
MAX_GRAPH_DEPTH=3
MAX_GRAPH_NODES=50
TOP_K_RERANKED=10